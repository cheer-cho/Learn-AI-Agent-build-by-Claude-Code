# TechCorp AI Agents Lab Course — environment template
# Copy this file to .env and fill in what you have.
# Everything runs OFFLINE by default: with no key set, mock adapters are used
# and all default tests pass without spending anything.

# --- LLM provider (any OpenAI-compatible endpoint) ---------------------------
# Works with OpenAI, Anthropic's compatible endpoint, OpenRouter, or local
# Ollama (http://localhost:11434/v1). Leave blank to stay in offline mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Embeddings ---------------------------------------------------------------
# Local sentence-transformers model (downloaded once, free to run).
# Leave as-is unless you know you want a different model.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Course behavior ----------------------------------------------------------
# Force offline mode even when a key is present (true/false).
TECHCORP_OFFLINE=
# Cost guardrails used from Module 02 onwards (USD per 1M tokens).
COST_INPUT_PER_MTOK=1.00
COST_OUTPUT_PER_MTOK=4.00
# Hard cap on model output tokens per request.
MAX_OUTPUT_TOKENS=1024

# --- Level 4+ (optional) --------------------------------------------------------
# LangSmith tracing (Module 19). Leave blank to use the local trace fallback.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=techcorp-agent
